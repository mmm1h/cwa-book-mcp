LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
CWA_BASE_URL=http://calibre-web-automated:8083
CWA_USERNAME=<CWA_SERVICE_USER>
# Operator must confirm existing CWA rules before enabling writes.
CWA_WRITE_ENABLED=false
CWA_EXPECTED_FORMAT=epub
CWA_INPUT_FORMATS=epub,pdf
CWA_OUTPUT_FORMATS=epub,pdf
CWA_CONFIRM_WINDOW=15m
# Limits are bytes, including 64 KiB allowance on the CWA multipart leg.
MAX_FILE_BYTES=536870912
MAX_STAGING_BYTES=4294967296
CWA_MAX_UPLOAD_BYTES=536936448
ZLIB_DOMAIN=https://example.invalid
ZLIB_MODE=eapi
# Exact additional origins, only when verified for the chosen source session.
ZLIB_FILE_ORIGINS=
